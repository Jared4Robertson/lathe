{
  "name": "lathe-desktop",
  "private": true,
  "license": "Apache-2.0",
  "version": "0.1.0",
  "description": "Lathe as a desktop app: an Electron shell around the Lathe web app and server.",
  "author": "Jared A Robertson",
  "type": "module",
  "main": "out/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/speech.ts",
    "dev": "node scripts/dev.ts",
    "start": "npm --prefix ../lathe run build && npm run build && electron .",
    "pack": "npm --prefix ../lathe run build && npm run build && node scripts/stage-lathe.ts && electron-builder --mac --dir",
    "pack:dmg": "npm --prefix ../lathe run build && npm run build && node scripts/stage-lathe.ts && electron-builder --mac dmg",
    "icon": "node scripts/icon.ts",
    "typecheck": "tsc --noEmit",
    "knip": "knip",
    "test": "vitest run --maxWorkers=2"
  },
  "build": {
    "appId": "dev.lathe.desktop",
    "productName": "Lathe",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "out/**",
      "!out/lathe-speech",
      "static/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "build/stage/node_modules",
        "to": "node_modules"
      },
      {
        "from": "out/lathe-speech",
        "to": "lathe-speech"
      }
    ],
    "npmRebuild": false,
    "electronDist": "node_modules/electron/dist",
    "publish": null,
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "build/icon.icns",
      "identity": null,
      "darkModeSupport": true,
      "extendInfo": {
        "CFBundleDocumentTypes": [
          {
            "CFBundleTypeName": "Folder",
            "CFBundleTypeRole": "Viewer",
            "LSHandlerRank": "Alternate",
            "LSItemContentTypes": [
              "public.folder"
            ]
          }
        ],
        "NSMicrophoneUsageDescription": "Lathe listens while you dictate to Claude in the chat. Speech is recognized on this Mac; audio never leaves it."
      }
    },
    "dmg": {
      "sign": false
    },
    "win": {
      "icon": "build/icon.ico"
    },
    "linux": {
      "icon": "build/icons"
    }
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "knip": "^6.43.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.12"
  },
  "overrides": {
    "minimatch@>=7.0.0 <11.0.1": "^11.0.1"
  }
}
