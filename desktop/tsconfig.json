{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node"],
    "paths": { "lathe-desktop-bridge": ["../app/src/shell/desktop-bridge.ts"], "lathe-config": ["../lathe/src/config.ts"] }
  },
  "include": ["src", "test", "scripts", "vitest.config.ts"]
}
