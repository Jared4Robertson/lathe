{
  "format": "lathe-theme",
  "version": 1,
  "name": "Lathe",
  "light": {
    "--shell": "#DDE3E6",
    "--paper": "#F4F6F5",
    "--sheet": "#FFFFFF",
    "--ink": "#1D2830",
    "--muted": "#5A6870",
    "--rule": "#CBD3D6",
    "--steel": "#2E6A88",
    "--steel-bg": "#E4EEF3",
    "--spark": "#B5512A",
    "--spark-bg": "#F8E8DF",
    "--warn": "#875C00",
    "--error": "#9E4320",
    "--error-bg": "var(--spark-bg)",
    "--g-discovery": "#75640E",
    "--g-discovery-bg": "#F4EFD8",
    "--g-domain-model": "#2E6A88",
    "--g-domain-model-bg": "#E4EEF3",
    "--g-use-cases": "#2F7148",
    "--g-use-cases-bg": "#E2F1E7",
    "--g-interaction-design": "#6A4C9C",
    "--g-interaction-design-bg": "#EEE8F6",
    "--g-technical-specification": "#B5512A",
    "--g-technical-specification-bg": "#F8E8DF",
    "--g-test-plan": "#A3365F",
    "--g-test-plan-bg": "#F7E4EC",
    "--g-structural": "var(--ink)",
    "--g-structural-bg": "var(--sheet)",
    "--g-file": "var(--muted)",
    "--on-mark": "#fff",
    "--shadow-soft": "rgb(0 0 0 / 0.12)",
    "--shadow": "rgb(0 0 0 / 0.16)",
    "--shadow-strong": "rgb(0 0 0 / 0.2)",
    "--shadow-deep": "rgb(0 0 0 / 0.25)",
    "--backdrop": "rgb(0 0 0 / 0.35)"
  },
  "dark": {
    "--shell": "#0A0F12",
    "--paper": "#11171B",
    "--sheet": "#182026",
    "--ink": "#E2E8EA",
    "--muted": "#93A2A9",
    "--rule": "#2C373D",
    "--steel": "#7DB4D0",
    "--steel-bg": "#1A2E3A",
    "--spark": "#E88A5E",
    "--spark-bg": "#3A2219",
    "--warn": "#E0B44C",
    "--on-mark": "#11171B",
    "--error": "var(--spark)",
    "--g-discovery": "#D6C060",
    "--g-discovery-bg": "#2E2912",
    "--g-domain-model": "#7DB4D0",
    "--g-domain-model-bg": "#1A2E3A",
    "--g-use-cases": "#7CC79A",
    "--g-use-cases-bg": "#17301F",
    "--g-interaction-design": "#B9A0E6",
    "--g-interaction-design-bg": "#261E36",
    "--g-technical-specification": "#E88A5E",
    "--g-technical-specification-bg": "#3A2219",
    "--g-test-plan": "#E58AAE",
    "--g-test-plan-bg": "#3A1A27"
  },
  "tokens": {
    "--display": "\"Archivo\", \"Helvetica Neue\", Arial, sans-serif",
    "--body": "\"Public Sans\", \"Segoe UI\", system-ui, sans-serif",
    "--mono": "\"JetBrains Mono\", ui-monospace, Menlo, monospace",
    "--text-size": "15px",
    "--density": "1",
    "--panel-radius": "8px",
    "--panel-gap": "6px",
    "--motion-speed": "320ms",
    "--hover-speed": "120ms"
  }
}
