{
  "format": "lathe-theme",
  "version": 1,
  "name": "Lathe",
  "light": {
    "--shell": "#DDE3E6",
    "--paper": "#F4F6F5",
    "--sheet": "#FFFFFF",
    "--ink": "#1D2830",
    "--muted": "#5A6870",
    "--rule": "#CBD3D6",
    "--steel": "#2E6A88",
    "--steel-bg": "#E4EEF3",
    "--spark": "#B5512A",
    "--spark-bg": "#F8E8DF",
    "--warn": "#875C00",
    "--error": "#9E4320",
    "--error-bg": "var(--spark-bg)",
    "--g-domain-model": "#2E6A88",
    "--g-domain-model-bg": "#E4EEF3",
    "--g-use-cases": "#2F7148",
    "--g-use-cases-bg": "#E2F1E7",
    "--g-interaction-design": "#6A4C9C",
    "--g-interaction-design-bg": "#EEE8F6",
    "--g-technical-specification": "#B5512A",
    "--g-technical-specification-bg": "#F8E8DF",
    "--g-test-plan": "#A3365F",
    "--g-test-plan-bg": "#F7E4EC",
    "--es-aggregate": "#7A6000",
    "--es-aggregate-bg": "#FFF4C2",
    "--es-command": "#2E5FA8",
    "--es-command-bg": "#DCE8FA",
    "--es-event": "#A84B12",
    "--es-event-bg": "#FFE3CC",
    "--es-policy": "#7A4FA0",
    "--es-policy-bg": "#EEE2F8",
    "--es-read-model": "#2F7148",
    "--es-read-model-bg": "#DDF2E3",
    "--es-rule": "#9C3F6E",
    "--es-rule-bg": "#F8E1EE",
    "--g-structural": "var(--ink)",
    "--g-structural-bg": "var(--sheet)",
    "--g-file": "var(--muted)",
    "--on-mark": "#fff",
    "--shadow-soft": "rgb(0 0 0 / 0.12)",
    "--shadow": "rgb(0 0 0 / 0.16)",
    "--shadow-strong": "rgb(0 0 0 / 0.2)",
    "--shadow-deep": "rgb(0 0 0 / 0.25)",
    "--backdrop": "rgb(0 0 0 / 0.35)"
  },
  "dark": {
    "--shell": "#0A0F12",
    "--paper": "#11171B",
    "--sheet": "#182026",
    "--ink": "#E2E8EA",
    "--muted": "#93A2A9",
    "--rule": "#2C373D",
    "--steel": "#7DB4D0",
    "--steel-bg": "#1A2E3A",
    "--spark": "#E88A5E",
    "--spark-bg": "#3A2219",
    "--warn": "#E0B44C",
    "--on-mark": "#11171B",
    "--error": "var(--spark)",
    "--g-domain-model": "#7DB4D0",
    "--g-domain-model-bg": "#1A2E3A",
    "--g-use-cases": "#7CC79A",
    "--g-use-cases-bg": "#17301F",
    "--g-interaction-design": "#B9A0E6",
    "--g-interaction-design-bg": "#261E36",
    "--g-technical-specification": "#E88A5E",
    "--g-technical-specification-bg": "#3A2219",
    "--g-test-plan": "#E58AAE",
    "--g-test-plan-bg": "#3A1A27",
    "--es-aggregate": "#E9C85A",
    "--es-aggregate-bg": "#332A0C",
    "--es-command": "#8DB4F0",
    "--es-command-bg": "#172640",
    "--es-event": "#F0A06A",
    "--es-event-bg": "#3B2414",
    "--es-policy": "#C6A4EA",
    "--es-policy-bg": "#2A1E38",
    "--es-read-model": "#7CC79A",
    "--es-read-model-bg": "#17301F",
    "--es-rule": "#E796BF",
    "--es-rule-bg": "#3A1A2C"
  },
  "tokens": {
    "--display": "\"Archivo\", \"Helvetica Neue\", Arial, sans-serif",
    "--body": "\"Public Sans\", \"Segoe UI\", system-ui, sans-serif",
    "--mono": "\"JetBrains Mono\", ui-monospace, Menlo, monospace",
    "--text-size": "15px",
    "--density": "1",
    "--panel-radius": "8px",
    "--panel-gap": "6px",
    "--motion-speed": "320ms",
    "--hover-speed": "120ms"
