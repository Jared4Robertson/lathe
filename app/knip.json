{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "server/lathe.ts"
  ],
  "project": [
    "src/**/*.{ts,tsx}",
    "server/**/*.ts",
    "test/**/*.{ts,tsx}",
    "stability/**/*.ts",
    "a11y/**/*.ts",
    "perf/**/*.ts"
  ],
  "playwright": {
    "config": [
      "stability/playwright.config.ts",
      "a11y/playwright.config.ts",
      "perf/playwright.config.ts"
    ],
    "entry": [
      "stability/**/*.spec.ts",
      "a11y/**/*.spec.ts",
      "perf/**/*.perf.ts"
    ]
  },
  "ignoreExportsUsedInFile": true
}
