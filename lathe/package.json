{
  "name": "@jaredrob/lathe",
  "private": true,
  "type": "module",
  "main": "dist/src/index.js",
  "scripts": {
    "check": "node bin/lathe.ts check --root ..",
    "lathe": "node bin/lathe.ts",
    "test": "vitest run --maxWorkers=2",
    "test:perf": "node perf/engine.ts",
    "typecheck": "tsc --noEmit",
    "knip": "knip",
    "reference": "node scripts/reference.ts",
    "schema": "node scripts/schema-types.ts",
    "build": "rm -rf dist && tsc -p tsconfig.build.json && npm run reference && npm --prefix ../app run build && cp -R ../plugin dist/plugin",
    "prepack": "npm run build",
    "generate": "node scripts/generate/main.ts"
  },
  "dependencies": {
    "@duckdb/node-api": "^2.0.0-r.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "knip": "^6.43.0",
    "typescript": "^7.0.2",
    "vitest": "^4.0.0"
  },
  "version": "4.0.0",
  "description": "Organize a product's lifecycle as checked, traceable records.",
  "types": "dist/src/index.d.ts",
  "bin": {
    "lathe": "dist/bin/lathe.js"
  },
  "files": [
    "dist",
    "data",
    "schema",
    "REFERENCE.md",
    "README.md"
  ]
}
