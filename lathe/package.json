{
  "name": "@jaredrob/lathe",
  "private": true,
  "type": "module",
  "main": "dist/src/index.js",
  "scripts": {
    "check": "node bin/lathe.ts check --root ..",
    "lathe": "node bin/lathe.ts",
    "test": "vitest run --maxWorkers=2",
    "test:perf": "node perf/engine.ts",
    "typecheck": "tsc --noEmit",
    "reference": "node bin/lathe.ts format --root . --out REFERENCE.md",
    "build": "rm -rf dist && tsc -p tsconfig.build.json && npm run reference && npm --prefix ../app run build",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@duckdb/node-api": "^2.0.0-r.1",
    "yaml": "^2.8.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2",
    "vitest": "^4.0.0"
  },
  "version": "0.1.0",
  "description": "Organize a product's lifecycle as checked, traceable records.",
  "types": "dist/src/index.d.ts",
  "bin": {
    "lathe": "dist/bin/lathe.js"
  },
  "files": [
    "dist",
    "checks",
    "meta",
    "FORMAT.md",
    "REFERENCE.md",
    "README.md"
  ]
}
