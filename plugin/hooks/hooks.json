{
  "description": "Refuse hand edits to a Lathe repo's data files: the spec changes only through Lathe's MCP tools, the CLI or the app.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/guard-data-files.mjs"],
            "timeout": 10
          }
        ]
      }
    ]
  }
}
